FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN npm install --global pnpm@11.25.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile
COPY . .
# Build uses an inert placeholder, never a production secret or database URL.
RUN PAYLOAD_SECRET=build-only-not-a-runtime-secret pnpm build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=8080
RUN npm install --global pnpm@11.25.0
COPY --from=build --chown=node:node /app /app
USER node
EXPOSE 8080
CMD ["pnpm", "exec", "next", "start", "--hostname", "0.0.0.0"]
